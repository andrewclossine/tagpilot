# TAGPILOT on the server: copy this file to .env (in the same folder as docker-compose.yml) and fill it in.
# Never put this file in Git.

# Your domain, without https:// (e.g. tagpilot.com)
DOMAIN=

# A long random password for the database. Generate one on the server with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Port the app listens on, on the server only (the web server forwards to it).
APP_PORT=3001

# Claude API key for the AI features.
ANTHROPIC_API_KEY=

# Flutterwave (LIVE keys in production). Webhook URL: https://<DOMAIN>/api/flutterwave/webhook
FLW_SECRET_KEY=
FLW_SECRET_HASH=
SUBSCRIPTION_CURRENCY=USD
SUBSCRIPTION_PRICE_MONTHLY=30
SUBSCRIPTION_PRICE_YEARLY=300

# Email for password reset, invoices and payslips.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TAGPILOT <no-reply@example.com>
