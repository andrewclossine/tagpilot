# Copy this file to .env.local and fill in the values.

# Claude API key for reading supporting documents (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Leave empty on your computer: Konti AI then uses a built-in database stored in ./data.
# In production, point it at a PostgreSQL database, e.g. postgres://user:password@host:5432/konti
DATABASE_URL=

# Where uploaded supporting documents are kept (default ./storage).
STORAGE_DIR=
