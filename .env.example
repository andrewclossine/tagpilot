# Copy this file to .env.local and fill in the values.

# Claude API key for the AI features (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Leave empty on your computer: TAGPILOT then uses a built-in database stored in ./data.
# In production, point it at a PostgreSQL database, e.g. postgres://user:password@host:5432/tagpilot
DATABASE_URL=

# Where uploaded supporting documents are kept (default ./storage).
STORAGE_DIR=

# Public address of the site, used in emails and payment redirects (e.g. https://app.tagpilot.com).
# Leave empty on your computer.
APP_URL=

# --- Subscription payments (Flutterwave, https://dashboard.flutterwave.com > Settings > API keys) ---
# Use the TEST secret key while trying things out, the LIVE key in production.
FLW_SECRET_KEY=
# The "secret hash" you choose under Settings > Webhooks; the webhook URL is <APP_URL>/api/flutterwave/webhook
FLW_SECRET_HASH=
# The single plan's prices.
SUBSCRIPTION_CURRENCY=USD
SUBSCRIPTION_PRICE_MONTHLY=30
SUBSCRIPTION_PRICE_YEARLY=300

# --- Email for password reset (any SMTP server: Gmail, Outlook, your domain's mail server...) ---
# Without SMTP on your computer, reset links are printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TAGPILOT <no-reply@example.com>
