{
  "name": "tagpilot-desktop",
  "productName": "TAGPILOT",
  "version": "1.0.0",
  "description": "TAGPILOT for Windows: opens tagpilotsolution.com in its own window.",
  "author": "TAGPILOT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.tagpilotsolution.desktop",
    "productName": "TAGPILOT",
    "copyright": "TAGPILOT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TAGPILOT",
      "artifactName": "TAGPILOT-Setup.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
